{
  "name": "ossuary",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "lint:install": "npm ci --prefix tools/lint",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\"",
    "test": "vitest run && playwright test",
    "prepare-asset": "tsx tools/prepare-asset.ts",
    "prepare-texture": "tsx tools/prepare-texture.ts",
    "prepare-sound": "tsx tools/prepare-sound.ts",
    "viewer-sounds": "tsx tools/viewer-sounds.ts",
    "inspect": "tsx tools/inspect-rooms.ts",
    "review-checks": "tsx tools/review-checks.ts",
    "balance": "tsx tools/balance.ts",
    "foe-sheet": "tsx tools/foe-sheet.ts",
    "render-audio": "tsx tools/render-audio.ts",
    "animate-creature": "tsx tools/animate-creature.ts",
    "creature-strip": "tsx tools/creature-strip.ts",
    "texel-bake": "tsx tools/texel-bake.ts",
    "creature-preview": "tsx tools/creature-preview.ts",
    "milestone": "tsx tools/milestone.ts",
    "devboard": "tsx tools/devboard/server.ts",
    "devboard:selftest": "tsx tools/devboard/selftest.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:fast": "playwright test --grep @fast"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
